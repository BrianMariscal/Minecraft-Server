# ===========================================================================
#  Minecraft HD — secretos y datos de entorno
# ===========================================================================
#  Copia este archivo a .env y llénalo. `mc setup` te va preguntando lo
#  que falte si prefieres hacerlo así.
#
#  .env NUNCA entra a git (está en .gitignore). No lo compartas, no lo
#  pegues en Discord, no lo subas a ningún lado.
# ===========================================================================

# --- RCON ------------------------------------------------------------------
#  Contraseña de la consola remota del servidor. La usan `mc console`,
#  `mc whitelist`, el contenedor de respaldos y nada más.
#  El puerto 25575 vive solo en la red interna de Docker: no lo abras
#  en el firewall. Genera una contraseña larga con:
#      python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RCON_PASSWORD=

# --- DiscordSRV (chat del servidor <-> Discord) ----------------------------
#  Bot #1. Guía paso a paso: docs/discord.md
DISCORD_TOKEN=
#  Canal donde se refleja el chat del juego.
DISCORD_CHANNEL_CHAT=
#  Canal de consola, solo para admins. Déjalo vacío si en settings.yml
#  tienes discord.canal_consola: false
DISCORD_CHANNEL_CONSOLA=

# --- Bot de pagos del VPS --------------------------------------------------
#  Bot #2, SEPARADO del de DiscordSRV. Necesita su propia aplicación en el
#  Discord Developer Portal. Guía: docs/bot-pagos.md
PAGOS_BOT_TOKEN=
#  ID del servidor (guild) de Discord donde vive el bot.
PAGOS_GUILD_ID=
#  ID del canal #pagos donde manda los avisos.
PAGOS_CANAL_ID=

# --- Respaldos fuera del VPS (opcional) ------------------------------------
#  Solo si en settings.yml pusiste respaldos.remoto.activo: true
#  Ver docs/respaldos.md para generar el config de rclone.
RCLONE_REMOTE_CONFIG=

# --- Zona horaria del host -------------------------------------------------
TZ=America/Mexico_City

# ===========================================================================
#  Minecraft HD — secretos y datos de entorno
# ===========================================================================
#  Copia este archivo a .env y llénalo. `mc setup` te va preguntando lo
#  que falte si prefieres hacerlo así.
#
#  .env NUNCA entra a git (está en .gitignore). No lo compartas, no lo
#  pegues en Discord, no lo subas a ningún lado.
# ===========================================================================

# --- RCON ------------------------------------------------------------------
#  Contraseña de la consola remota del servidor. La usan `mc console`,
#  `mc whitelist` y los respaldos en caliente.
#  El puerto 25575 vive solo en la red interna de Docker: no lo abras
#  en el firewall. Genera una contraseña larga con:
#      python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RCON_PASSWORD=

# --- Bot de pagos del VPS --------------------------------------------------
#  El único bot de Discord del proyecto. Guía: docs/bot-pagos.md
PAGOS_BOT_TOKEN=
#  ID del servidor (guild) de Discord donde vive el bot.
PAGOS_GUILD_ID=
#  ID del canal #pagos donde manda los avisos.
PAGOS_CANAL_ID=

#  Opcional: canal donde el bot de pagos avisa si el servidor de Minecraft
#  se cae y cuando vuelve. Vacío = no vigila. Puede ser el mismo #pagos.
ALERTAS_CANAL_ID=

# --- Zona horaria del host -------------------------------------------------
TZ=America/Mexico_City

# --- Lo que escribe `mc build` ---------------------------------------------
#  Al final de .env, `mc build` agrega un bloque marcado con la versión, la
#  memoria, los puertos y los respaldos que saca de settings.yml (variables
#  MC_*). Docker Compose las lee de aquí. No lo edites: cambia settings.yml
#  y vuelve a correr `mc build`.

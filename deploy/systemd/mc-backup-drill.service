[Unit]
Description=Simulacro mensual de restauración de Minecraft HD
Documentation=file:///home/minecraft/minecraft-hd/docs/respaldos.md
OnFailure=mc-backup-alerta.service

[Service]
Type=oneshot
User=minecraft
Group=minecraft
WorkingDirectory=/home/minecraft/minecraft-hd
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/minecraft/minecraft-hd/.venv/bin/mc backup drill ultimo
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h

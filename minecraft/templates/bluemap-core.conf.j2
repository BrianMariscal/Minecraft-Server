# ===========================================================================
#  GENERADO POR `mc build` — NO LO EDITES A MANO
#  Cambia settings.yml y vuelve a correr `mc build`.
# ===========================================================================
#  BlueMap dibuja el mundo en una página web en 3D.
#  Se abre en http://TU-IP:{{ puerto_bluemap }}
# ===========================================================================

# BlueMap necesita los texturas y modelos del cliente de Minecraft para poder
# dibujar el mundo, así que descarga el jar oficial de Mojang. Viene en false
# y el plugin NO ARRANCA hasta que lo pongas en true, porque al hacerlo estás
# aceptando el EULA de Minecraft (https://account.mojang.com/documents/minecraft_eula).
# Como ya aceptaste el EULA para correr el servidor, aquí va en true.
accept-download: true

# Dónde guarda BlueMap sus datos (los mosaicos del mapa pesan bastante).
# Es relativo a la carpeta del plugin.
data: "bluemap"

# BlueMap usa 1 hilo. Con 4 vCores le damos 2: dibuja el mapa el doble de
# rápido y todavía le quedan 2 al servidor. No le des más o el pregen y el
# render se van a pelear por la CPU.
render-thread-count: 2

# Segundos que espera antes de volver a dibujar un chunk que cambió.
# BlueMap usa 60. Lo subimos a 300 (5 min): con granjas que cambian bloques
# todo el tiempo, redibujar cada minuto es puro gasto de CPU.
update-cooldown: 300

# Minutos entre repasos completos del mapa. BlueMap usa 1440 (un día) y así
# se queda: alcanza para que no se queden pedazos viejos.
full-update-interval: 1440

# Los datapacks que usamos (Terralith, Incendium, Nullscape) son de bloques
# vanilla, así que no traen texturas propias que BlueMap tenga que leer.
# Aun así lo dejamos prendido: no cuesta y cubre si algún día agregamos algo.
scan-for-mod-resources: true

metrics: true

log: {
  file: "bluemap/logs/debug.log"
  append: false
}

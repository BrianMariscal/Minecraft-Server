# ===========================================================================
#  GENERADO POR `mc build` — NO LO EDITES A MANO
#  Cambia settings.yml y vuelve a correr `mc build`.
# ===========================================================================
#  Paper reescribe este archivo y le borra los comentarios en cada arranque.
#  La copia comentada es la de minecraft/generated/.
#  Referencia: https://docs.papermc.io/paper/reference/bukkit-configuration/
# ===========================================================================

settings:
  allow-end: true
  warn-on-overload: true
  permissions-file: permissions.yml
  update-folder: update
  # Bukkit usa 4000 ms entre intentos de conexión de la misma IP. Lo bajamos
  # porque los jugadores de Bedrock a veces reconectan rápido al cambiar de
  # red (wifi a datos) y 4 segundos los dejaba fuera.
  connection-throttle: 2000
  query-plugins: true
  # Lo que se ve al apagar el servidor. Por defecto: "Server closed".
  shutdown-message: "Servidor apagado. Volvemos en un momento."
  minimum-api: none
  use-map-color-cache: true

# --- Límites de spawn ------------------------------------------------------
#  Cuántos mobs de cada tipo puede haber por jugador (porque en
#  paper-world-defaults tenemos per-player-mob-spawns: true).
#
#  Son los valores vanilla por diseño. Bajarlos es la forma más común de
#  matar sin querer las granjas de mobs, y con {{ max_jugadores }} jugadores
#  máximo el VPS los aguanta de sobra.
spawn-limits:
  monsters: 70
  animals: 10
  water-animals: 5
  water-ambient: 20
  water-underground-creature: 5
  axolotls: 5
  ambient: 15

chunk-gc:
  # Bukkit usa 600 ticks (30 s). Lo dejamos: con delay-chunk-unloads-by en
  # 30s de Paper ya tenemos el colchón que queríamos para las granjas.
  period-in-ticks: 600

ticks-per:
  # Estos son los valores vanilla. NO los tocamos: cada uno es cada cuántos
  # ticks el servidor intenta generar mobs de ese tipo, y subirlos es
  # exactamente lo que hace que una granja rinda la mitad.
  animal-spawns: 400
  monster-spawns: 1
  water-spawns: 1
  water-ambient-spawns: 1
  water-underground-creature-spawns: 1
  axolotl-spawns: 1
  ambient-spawns: 1
  # Bukkit guarda el mundo cada 6000 ticks (5 min). Lo dejamos así; el
  # autosave de jugadores sí lo hicimos más seguido en paper-global.yml.
  autosave: 6000

aliases: now-in-commands.yml
